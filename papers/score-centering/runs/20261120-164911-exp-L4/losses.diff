+RHO_MAX = 4.0     # cap on the tail mass ratio rho = q_tail / p_tail
+TAIL_EPS = 1e-6   # floor on p_tail
+
+
+def sampler_baseline(logp_vocab, head_ids, head_logprobs):
+    """Surrogate sum_{v in H} sg[q_v - rho p_v] log p_v, whose gradient is
+    s_bar(h) = E_q[grad log p(v|h)] when q's tail outside the sampler's top-k
+    head H is modelled as rho * p (rho = q_tail / p_tail). The tail term
+    rho * sum_{v not in H} p_v grad log p_v = -rho * sum_{v in H} p_v grad log p_v,
+    because sum_v p_v grad log p_v = grad sum_v p_v = 0. Its value is not
+    meaningful, only its gradient. Returns (surrogate [B, C], rho [B, C])."""
+    logp_head = take_vocab(logp_vocab, head_ids)               # [B, C, K]
+    q_head = jnp.exp(head_logprobs.astype(jnp.float32))        # -inf entries -> 0
+    p_head = sg(jnp.exp(logp_head))
+    q_tail = jnp.clip(1.0 - q_head.sum(-1), 0.0, 1.0)
+    p_tail = jnp.clip(1.0 - p_head.sum(-1), 0.0, 1.0)
+    rho = jnp.clip(q_tail / jnp.maximum(p_tail, TAIL_EPS), 0.0, RHO_MAX)
+    coef = sg(q_head - rho[..., None] * p_head)
+    coef = jnp.where(jnp.isfinite(head_logprobs), coef, 0.0)
+    return (coef * jnp.where(coef != 0, logp_head, 0.0)).sum(-1), rho
+
