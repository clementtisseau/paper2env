+def sampler_centering(logp_vocab, b, positive, c):
+    """Detached coefficients (ids, coef) of the centering term
+    sum_{v in H} coef_v log p(v|h), the expected score under the sampling
+    measure, with the sampler's top-k head H and its tail modelled as
+    proportional to p (see REPORT.md).
+
+    The sampling measure is q(v) w(p_v/q_v): q itself without a token-level
+    correction (w = 1). Since sum_v p_v grad log p_v = 0, a tail measure
+    proportional to p contributes no gradient, and is subtracted from the
+    head as -rho_w p_v."""
+    ids = b["sampler_topk_ids"]
+    logq_head = b["sampler_topk_logprobs"].astype(jnp.float32)
+    logq_head = jnp.where(jnp.isfinite(logq_head), logq_head, -jnp.inf)
+    logp_head = sg(take_vocab(logp_vocab, ids))
+    q_head = jnp.exp(logq_head)
+    p_head = jnp.exp(logp_head)
+    q_tail = jnp.clip(1.0 - q_head.sum(-1), 0.0, 1.0)
+    p_tail = jnp.clip(1.0 - p_head.sum(-1), 0.0, 1.0)
+    # tail mass ratio q_tail / p_tail; no tail model when either tail is negligible
+    rho = jnp.where((p_tail > 1e-6) & (q_tail > 1e-6), q_tail / jnp.maximum(p_tail, 1e-6), 0.0)
+    rho = jnp.minimum(rho, 1e3)
+    pos = jnp.broadcast_to(positive[..., None], q_head.shape)
+    if c is None:
+        m_head = q_head
+        rho_w = rho
+    else:
+        # head: exact measure q_v w(p_v / q_v); tail: q = rho p, so p/q = 1/rho
+        tv_head = jnp.abs(q_head - p_head)
+        m_head = jnp.exp(log_mass(logp_head, logq_head, pos, c, tv_head))
+        log_rho = jnp.log(jnp.maximum(rho, 1e-30))
+        rho_w = jnp.where(rho > 0, rho * is_weight(-log_rho, positive, c, jnp.abs(rho - 1.0) * p_tail), 0.0)
+    coef = sg(m_head - rho_w[..., None] * p_head)
+    return coef, take_vocab(logp_vocab, ids)
+
