+def drop_vocab(logp, ids, fill=-1e30):
+    """logp with the entries at ids [B, C, K] replaced by `fill` (gradient
+    zero there, identity elsewhere). Same sharding caveat as take_vocab."""
+    spec = jax.typeof(logp).sharding.spec
+    b = jnp.arange(ids.shape[0])[:, None, None]
+    c = jnp.arange(ids.shape[1])[None, :, None]
+    if spec[-1] is None:
+        return logp.at[b, c, ids].set(fill)
+    return logp.at[b, c, ids].set(fill, out_sharding=P(*spec))
+
+
+def sampler_mean_score(logp_vocab, top_ids, top_logq, log_p_tok, positive, c):
+    """Surrogate whose gradient is the drift direction at each position,
+
+        s_bar(h) = sum_v m(v|h) grad log p(v|h),   m = q * w(p/q)
+
+    (m = q without a token-level correction), evaluated with the sampler's
+    top-K logprobs. Off the top-K, q is extrapolated as proportional to p
+    (q~(v) = p(v) (1-Q)/(1-P), Q, P = top-K masses), so the tail contributes
+    m_tail * grad log P_tail with P_tail = sum_{v not in K} p(v): exact in
+    logit space and zero on-policy. Returns (surrogate [B, C], metrics)."""
+    logp_k = take_vocab(logp_vocab, top_ids)                     # [B, C, K], carries gradient
+    log_tail = jax.nn.logsumexp(drop_vocab(logp_vocab, top_ids), -1)  # log P_tail, carries gradient
+    lp_k, lq_k = sg(logp_k), top_logq.astype(jnp.float32)
+    q_tail = jnp.clip(1.0 - jnp.exp(lq_k).sum(-1), 0.0, 1.0)     # 1 - Q
+    p_tail = jnp.exp(sg(log_tail))                               # 1 - P, computed without cancellation
+    has_tail = p_tail > 1e-30
+    if c is None or c.level != "token":
+        m_k = jnp.exp(lq_k)
+        m_tail = q_tail
+    else:
+        pos = positive[..., None]
+        tv_k = jnp.abs(jnp.exp(lq_k) - jnp.exp(lp_k))
+        m_k = jnp.exp(log_mass(lp_k, lq_k, pos, c, tv_k))
+        # on the tail the ratio p/q~ is the constant P_tail / (1 - Q)
+        log_qt = jnp.log(jnp.maximum(q_tail, 1e-30))
+        lp_t = jnp.where(has_tail, sg(log_tail), -69.0)
+        m_tail = jnp.where(q_tail > 0, jnp.exp(log_mass(lp_t, log_qt, positive, c, jnp.abs(q_tail - p_tail))), 0.0)
+    m_tail = jnp.where(has_tail, m_tail, 0.0)
+    surrogate = (m_k * logp_k).sum(-1) + m_tail * jnp.where(has_tail, log_tail, 0.0)
+    surrogate = surrogate - sg(surrogate)  # value 0: only its gradient matters
+    # || q~ - p ||_1 / 2 over the vocabulary: size of the drift direction (in logit space)
+    drift_tv = 0.5 * (jnp.abs(jnp.exp(lq_k) - jnp.exp(lp_k)).sum(-1) + jnp.abs(q_tail - p_tail))
+    return surrogate, {"drift_tv": drift_tv, "tail_q": q_tail}
+
