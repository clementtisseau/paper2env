+TAIL_RATIO_MAX = 100.0  # numerical cap on the tail coefficient (1 - Q) w_tail / (1 - P)
+
+
+def sampler_mean_score_coef(logp_k, logq_k, positive, c):
+    """Detached coefficients a_k such that sum_k a_k * grad log p(k|h) is the
+    expected (IS-weighted) score under the sampler, E_{v~q}[w(v) grad log p(v|h)],
+    computed from the sampler's top-K list plus one "tail" bucket.
+
+    logp_k, logq_k [B, C, K]: trainer / sampler logprobs of the sampler's top-K ids.
+    The tail (tokens outside the top-K) is a single outcome with masses 1 - P
+    (trainer) and 1 - Q (sampler); its score is grad log(1 - P) =
+    -sum_k p_k grad log p_k / (1 - P), so everything is expressed on the top-K:
+        a_k = q_k w_k - (1 - Q) w_tail p_k / (1 - P).
+    With q = p (on-policy, no correction) a_k = 0 exactly: the loss is unchanged.
+    """
+    logq_k = jnp.clip(logq_k, -1e4, 0.0)                    # -inf padding -> q = 0
+    q_k, p_k = jnp.exp(logq_k), sg(jnp.exp(logp_k))
+    Q = jnp.clip(q_k.sum(-1, keepdims=True), 0.0, 1.0)
+    P = jnp.clip(p_k.sum(-1, keepdims=True), 0.0, 1.0)
+    tail_q, tail_p = jnp.maximum(1.0 - Q, 0.0), jnp.maximum(1.0 - P, 1e-12)
+    if c is None:
+        w_k, w_tail = 1.0, 1.0
+    else:
+        w_k = is_weight(sg(logp_k) - logq_k, positive[..., None], c, sg(jnp.abs(q_k - p_k)))
+        w_tail = is_weight(jnp.log(tail_p) - jnp.log(jnp.maximum(tail_q, 1e-12)), positive[..., None], c,
+                           sg(jnp.abs(tail_q - tail_p)))
+    tail_coef = jnp.clip(tail_q * w_tail / tail_p, 0.0, TAIL_RATIO_MAX)
+    return sg(q_k * w_k - tail_coef * p_k)
+
