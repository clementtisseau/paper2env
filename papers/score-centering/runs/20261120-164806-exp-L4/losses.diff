@@ -91,6 +94,35 @@
     return logp.at[b, c, ids].get(out_sharding=P(*spec[:-1], None))
 
 
+TAIL_EPS = 1e-6     # smooths rho = q_tail / p_tail when both tails vanish (rho -> 1)
+RHO_MAX = 1e3       # bound on rho; float32 cancellation in the head weights scales with it
+
+
+def centered_baseline(logp_vocab, head_ids, head_logprobs):
+    """sum_v sg[q~(v|h)] log p(v|h) per position, whose gradient is the
+    sampler-mean score s_bar(h) = sum_v q~(v|h) grad log p(v|h).
+
+    q~ is the sampler's next-token distribution: exact on its top-k head H,
+    and proportional to p on the tail, q~_v = rho p_v with
+    rho = q_tail / p_tail. Because sum_v p_v grad log p_v = 0, the tail's
+    contribution rho * sum_{v not in H} p_v s_v equals -rho * sum_{v in H} p_v s_v,
+    so only head logprobs are needed:
+        s_bar = sum_{v in H} (q_v - rho p_v) grad log p_v.
+    The logit-space gradient of the resulting score is e_y - q~ (instead of
+    e_y - p for plain REINFORCE)."""
+    head_ids = jnp.clip(head_ids.astype(jnp.int32), 0, logp_vocab.shape[-1] - 1)
+    logp_head = take_vocab(logp_vocab, head_ids)                               # [B, C, K]
+    logq_head = head_logprobs.astype(jnp.float32)
+    valid = jnp.isfinite(logq_head)                                          # padded head entries
+    q_head = jnp.where(valid, jnp.exp(jnp.where(valid, logq_head, 0.0)), 0.0)
+    p_head = sg(jnp.where(valid, jnp.exp(logp_head), 0.0))
+    q_tail = jnp.clip(1.0 - q_head.sum(-1, keepdims=True), 0.0, 1.0)
+    p_tail = jnp.clip(1.0 - p_head.sum(-1, keepdims=True), 0.0, 1.0)
+    rho = jnp.minimum((q_tail + TAIL_EPS) / (p_tail + TAIL_EPS), RHO_MAX)
+    weights = sg(jnp.where(valid, q_head - rho * p_head, 0.0))
+    return (weights * jnp.where(valid, logp_head, 0.0)).sum(-1)
+
+
