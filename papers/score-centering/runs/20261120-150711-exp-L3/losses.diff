+def drift_baseline(logp_vocab, b):
+    """b(h) = sum_v q(v|h) log p(v|h) over the sampler's distribution q, with
+    q restricted to its top-K tokens and renormalized. Its gradient is the
+    q-mean score s_bar(h) = sum_v q(v|h) grad log p(v|h), a function of the
+    prefix only. Returns zeros when the batch carries no sampler top-K."""
+    if "sampler_topk_ids" not in b:
+        return jnp.zeros_like(b["sampling_token_logprobs"])
+    q = sg(jax.nn.softmax(b["sampler_topk_logprobs"].astype(jnp.float32), -1))
+    return (q * take_vocab(logp_vocab, b["sampler_topk_ids"])).sum(-1)
