+def drift_baseline(logp_vocab, top_ids, top_logq):
+    """Expected score under the sampler, s_bar(h) = sum_v q(v|h) grad log p(v|h),
+    as a surrogate on log p, restricted to the sampler's top-k head H.
+
+    The tail of q (outside H) is modelled as proportional to p, q_v = rho * p_v,
+    with rho = q_tail / p_tail. Since sum_v p_v grad log p_v = 0, the tail adds
+    rho * sum_tail p_v grad log p_v = -rho * sum_H p_v grad log p_v, so
+        s_bar(h) ~= sum_{v in H} (q_v - rho p_v) grad log p_v.
+    Returns sum_{v in H} sg[q_v - rho p_v] * log p_v, shape [B, C]: its gradient
+    is the expected score under the model. p_tail is taken in log space from the
+    full trainer distribution, so no cancellation; rho = 0 when H covers all of p."""
+    logp_top = take_vocab(logp_vocab, top_ids)  # [B, C, K]
+    q_top = jnp.exp(top_logq.astype(jnp.float32))
+    in_head = jnp.zeros(logp_vocab.shape, bool).at[
+        jnp.arange(top_ids.shape[0])[:, None, None], jnp.arange(top_ids.shape[1])[None, :, None], top_ids].set(True)
+    log_p_tail = sg(jax.nn.logsumexp(jnp.where(in_head, -jnp.inf, logp_vocab), -1))  # [B, C]
+    log_q_tail = jnp.log(jnp.maximum(1.0 - q_top.sum(-1), 0.0))
+    rho = jnp.where(jnp.isfinite(log_p_tail), jnp.exp(sg(log_q_tail) - log_p_tail), 0.0)
+    coef = sg(q_top - rho[..., None] * jnp.exp(sg(logp_top)))
+    return (coef * logp_top).sum(-1)
+
