+def drift_baseline(logp_vocab, topk_ids, topk_logq, rho_max=4.0):
+    """b(h) = sum_v c_v log p(v|h) over the sampler's top-k set, with c_v a
+    stop-gradient weight. Its gradient, sum_v c_v grad log p(v|h), estimates the
+    drift s_bar(h) = sum_v q(v|h) grad log p(v|h) that the sampler's
+    distribution q injects into the score. The tail weight rho is chosen so the
+    tail of c sums to zero, which makes c = 0 exactly on-policy (q = p)."""
+    logp_top = take_vocab(logp_vocab, topk_ids)                 # [B, C, K] trainer logprobs
+    q_top, p_top = sg(jnp.exp(topk_logq)), sg(jnp.exp(logp_top))
+    q_mass, p_mass = q_top.sum(-1), p_top.sum(-1)
+    rho = jnp.clip((1.0 - q_mass) / jnp.maximum(1.0 - p_mass, 1e-6), 0.0, rho_max)
+    c = q_top - rho[..., None] * p_top
+    return (c * logp_top).sum(-1)                               # [B, C]
+
