+def score_baseline(logp_vocab, topk_ids, topk_logq, positive, c=None):
+    """Baseline b(h) = E_q[X_v | h] for the per-token term X_y = w_y * s_y,
+    where s_v = grad log p(v|h) and w_v = w(p(v|h)/q(v|h)) is the IS weight of
+    the sampler's own next-token distribution (w_v = 1 without a correction).
+    The expectation runs over the sampler's top-K support, renormalised there.
+
+    Returns [B, C] values; the loss uses logp_y - b(h) per token, whose gradient
+    is s_y - sum_v q(v|h) w_v s_v.  positive [B, 1] is the advantage sign, which
+    selects the branch of the IS weight when a sign-dependent correction is set.
+    """
+    logp_k = take_vocab(logp_vocab, topk_ids)                        # [B, C, K], carries grad
+    logq_k = topk_logq.astype(jnp.float32)
+    q_k = sg(jax.nn.softmax(logq_k, -1))                             # q(v|h) renormalised on top-K
+    if c is None:
+        return (q_k * logp_k).sum(-1)
+    tv_k = sg(jnp.abs(jnp.exp(logq_k) - jnp.exp(logp_k)))
+    pos = positive[..., None]                                        # [B, 1, 1]
+    w_k = jnp.where(pos, is_weight(logp_k - logq_k, True, c, tv_k),
+                    is_weight(logp_k - logq_k, False, c, tv_k))
+    return (q_k * w_k * logp_k).sum(-1)
+
