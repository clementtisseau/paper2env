+def expected_score(logp_vocab, topk_ids, topk_logq, positive, c=None):
+    """Surrogate whose gradient is the drift sbar_c(h) = E_q[w(p/q) grad log p(y|h)]
+    at every position: sum_{v in top-k} m_v log p_v + m_rest log p_rest, with the
+    detached masses m = q * w(p/q) (m = q without correction) given by log_mass.
+
+    The sampler only reports its top-k next tokens; the rest of the vocabulary is
+    one merged outcome "rest" with q_rest = 1 - sum_k q_v and p_rest = 1 - sum_k p_v.
+    Without correction and with q = p the surrogate is sum_v p_v log p_v over a
+    partition of the vocabulary, whose gradient is exactly zero: on-policy nothing
+    changes. Returns [B, C]."""
+    logq_k = topk_logq.astype(jnp.float32)
+    logp_k = take_vocab(logp_vocab, topk_ids)  # [B, C, K]
+    p_k, q_k = jnp.exp(logp_k), jnp.exp(logq_k)
+    p_rest = jnp.clip(1.0 - p_k.sum(-1), 1e-6, 1.0)  # float32 cancellation floor
+    q_rest = jnp.clip(1.0 - q_k.sum(-1), 0.0, 1.0)
+    logp_rest = jnp.log(p_rest)
+    logq_rest = jnp.log(jnp.maximum(q_rest, 1e-30))
+    pos = positive[..., None]
+    tv_k = sg(jnp.abs(q_k - p_k))
+    m_k = sg(jnp.exp(log_mass(sg(logp_k), logq_k, pos, c, tv_k)))
+    m_rest = sg(jnp.exp(log_mass(sg(logp_rest), logq_rest, positive, c, sg(jnp.abs(q_rest - p_rest)))))
+    m_rest = jnp.where(q_rest > 0, m_rest, 0.0)
+    return (m_k * logp_k).sum(-1) + m_rest * logp_rest
+
