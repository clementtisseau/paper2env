+def sampler_baseline(logp_vocab, topk_ids, topk_logq, positive, c):
+    """Per-position surrogate whose gradient is the expected (IS-weighted)
+    score under the sampler, s_bar(h) = sum_v q(v|h) w(v) grad log p(v|h).
+
+    The sampler only reports its top-k logprobs. Its remaining mass
+    1 - Q_k is spread over the other tokens in proportion to the trainer's
+    probabilities (the best guess with no further information), so
+        q(v) ~= p(v) (1 - Q_k) / (1 - P_k)   for v outside the top-k,
+    where Q_k, P_k are the q- and p-mass on the top-k ids. With no correction
+    w = 1. Returns (baseline [B, C], |q_hat - p|_1 [B, C] as a drift metric).
+    """
+    valid = jnp.isfinite(topk_logq)
+    topk_logq = jnp.where(valid, topk_logq, -jnp.inf)
+    logp_k = take_vocab(logp_vocab, topk_ids)                          # [B, C, K] (differentiable)
+    p_k = sg(jnp.exp(logp_k)) * valid
+    q_k = jnp.exp(topk_logq)
+    Q = jnp.clip(q_k.sum(-1), 0.0, 1.0)
+    P_mass = jnp.clip(p_k.sum(-1), 0.0, 1.0)
+    log_q_tail = jnp.log1p(-jnp.minimum(Q, 1 - 1e-6))
+    log_p_tail = jnp.log1p(-jnp.minimum(P_mass, 1 - 1e-6))
+    # sum over tokens outside the top-k of sg(p_v) log p_v
+    plogp_all = (sg(jnp.exp(logp_vocab)) * logp_vocab).sum(-1)
+    plogp_tail = plogp_all - (p_k * jnp.where(valid, logp_k, 0.0)).sum(-1)
+    pos = positive[..., None] if positive.ndim == logp_k.ndim - 1 else positive
+    # corrected masses m_v = q_v w(p_v / q_v); for the tail, w is evaluated on the aggregate tail ratio
+    tv_k = sg(jnp.abs(q_k - jnp.exp(logp_k)))
+    m_k = sg(jnp.exp(log_mass(sg(logp_k), topk_logq, pos, c, tv_k))) * valid
+    tv_tail = sg(jnp.abs(jnp.exp(log_q_tail) - jnp.exp(log_p_tail)))
+    m_tail = sg(jnp.exp(log_mass(log_p_tail, log_q_tail, positive, c, tv_tail)))  # total tail mass
+    tail_scale = jnp.minimum(m_tail / jnp.exp(log_p_tail), 100.0)       # per-token factor on p_v (capped: fp32 cancellation)
+    base = (m_k * jnp.where(valid, logp_k, 0.0)).sum(-1) + sg(tail_scale) * plogp_tail
+    drift = (jnp.abs(q_k - p_k) * valid).sum(-1) + jnp.abs(jnp.exp(log_q_tail) - jnp.exp(log_p_tail))
+    return base, sg(drift)
+
