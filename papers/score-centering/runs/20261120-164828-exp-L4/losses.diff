+def sampler_baseline(logp_vocab, logp_head, ids, q_head_logp):
+    """Per-position coefficient-weighted score baseline b_t = sum_{v in H} c_v log p_v,
+    with c_v = sg[q_v - rho p_v] (see REPORT.md). Its gradient is sum_v sg[q_v] s_v
+    over the head plus rho times the tail-proportional part, so that
+    E_q[b] = sum_v q_v log p_v in expectation over the tail model."""
+    q_head = sg(jnp.exp(q_head_logp))                       # [B, C, K] sampler probs on the head
+    p_head = sg(jnp.exp(logp_head))                         # [B, C, K] trainer probs on the head
+    # trainer tail mass p_tail = sum over v outside H, computed in log space from the full vocab
+    b_idx = jnp.arange(ids.shape[0])[:, None, None]
+    c_idx = jnp.arange(ids.shape[1])[None, :, None]
+    in_head = jnp.zeros(logp_vocab.shape, bool).at[b_idx, c_idx, ids].set(True)
+    log_p_tail = sg(jax.nn.logsumexp(jnp.where(in_head, -jnp.inf, sg(logp_vocab)), axis=-1))   # [B, C]
+    # sampler tail mass from the head (1 - sum_H q); clamped away from zero
+    q_tail = jnp.clip(1.0 - q_head.sum(-1), 1e-12, 1.0)
+    p_tail = jnp.exp(log_p_tail)
+    rho = jnp.where(p_tail > 0, q_tail / jnp.where(p_tail > 0, p_tail, 1.0), 0.0)  # empty tail: rho unused
+    rho = jnp.clip(rho, 0.0, 1e6)
+    coef = sg(q_head - rho[..., None] * p_head)            # [B, C, K]
+    return (coef * logp_head).sum(-1)
+
