+RHO_MAX = 100.0   # cap on the tail mass ratio q_tail / p_tail
+P_TAIL_MIN = 1e-6  # float32 resolution of 1 - p_head
+
+
+def sampler_mean_score_surrogate(logp_vocab, head_ids, head_logprobs):
+    """sum_v sg[c_v] log p(v|h) whose gradient is s_bar(h) = E_q[grad log p(v|h)].
+
+    q is known on the sampler's top-k head H; its tail is modelled as
+    q_v = rho p_v (v not in H), rho = q_tail / p_tail. Since
+    sum_v p_v grad log p_v = 0, the tail's gradient equals -rho * the head's p
+    part, so c_v = q_v - rho p_v on H and nothing else is needed.
+    Returns (surrogate [B, C], q_tail [B, C], rho [B, C])."""
+    logp_head = take_vocab(logp_vocab, head_ids)                       # [B, C, K], differentiable
+    q_head = jnp.exp(head_logprobs.astype(jnp.float32))
+    q_tail = jnp.clip(1.0 - q_head.sum(-1), 0.0, 1.0)
+    p_tail = jnp.clip(-jnp.expm1(jax.nn.logsumexp(sg(logp_head), axis=-1)), 0.0, 1.0)
+    rho = jnp.clip(q_tail / jnp.maximum(p_tail, P_TAIL_MIN), 0.0, RHO_MAX)
+    coef = sg(q_head - rho[..., None] * jnp.exp(logp_head))
+    return (coef * logp_head).sum(-1), q_tail, rho
 
 
