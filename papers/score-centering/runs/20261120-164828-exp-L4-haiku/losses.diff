+def sampler_baseline(logp_vocab, topk_ids, topk_logprobs):
+    """Per-position baseline b(h) = sum_v sg[q_v - rho p_v] log p_v over the sampler's
+    top-k head H (see REPORT.md). Its gradient is s_bar(h) = E_q[grad log p | h] for
+    the head part, and the tail (q_tail = rho p_tail) adds nothing. Returns [B, C] in
+    the caller's chunk layout. Gradients flow through log p only."""
+    logp_top = take_vocab(logp_vocab, topk_ids)                          # [B, C, K], differentiable
+    q_top = sg(jnp.exp(topk_logprobs.astype(jnp.float32)))               # sampler head probs
+    p_top = sg(jnp.exp(logp_top))                                        # trainer head probs
+    q_tail = jnp.maximum(1.0 - q_top.sum(-1), 0.0)                       # sampler tail mass
+    p_tail = jnp.maximum(1.0 - p_top.sum(-1), 1e-6)                      # trainer tail mass
+    rho = q_tail / p_tail                                                # tail mass ratio q_tail / p_tail
+    coef = q_top - rho[..., None] * p_top                                # [B, C, K], stop-gradient
+    return (coef * logp_top).sum(-1)
+
