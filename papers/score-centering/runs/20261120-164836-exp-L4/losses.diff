+def sampler_mean_score(logp_vocab, b):
+    """sum_v sg[c_v] log p(v|h) over the sampler's top-k head H, where
+    c_v = q_v - rho p_v and rho = q_tail / p_tail (tail of q proportional to p).
+    Its gradient is s_bar(h) = sum_v q_v grad log p_v = sum_H c_v grad log p_v,
+    the mean score under q (see REPORT.md). Shapes: [B, C, V] -> [B, C]."""
+    ids = b["sampler_topk_ids"]
+    lp_h = take_vocab(logp_vocab, ids)                       # log p_v, v in H   [B, C, K]
+    p_h = jnp.exp(lp_h)
+    q_h = jnp.exp(b["sampler_topk_logprobs"].astype(jnp.float32))
+    p_tail = jnp.maximum(1.0 - p_h.sum(-1), 1e-6)            # trainer mass outside H
+    q_tail = jnp.clip(1.0 - q_h.sum(-1), 0.0, 1.0)           # sampler mass outside H
+    rho = q_tail / p_tail                                    # [B, C]
+    coef = sg(q_h - rho[..., None] * p_h)                    # [B, C, K]
+    return (coef * lp_h).sum(-1)
+
