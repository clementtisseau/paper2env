+TAIL_FLOOR = 1e-6  # smallest trainer tail mass whose log is differentiated
+
+
+def sampler_baseline(logp_vocab, topk_ids, topk_logq, positive, c=None):
+    """Per-position control variate b(h) = sum_v m(v|h) log p(v|h), m = sg(q * w(p/q)).
+
+    Its gradient is the drift direction s_bar(h) = sum_v m(v|h) grad log p(v|h),
+    which REINFORCE under q adds to the update with weight E_q[A | h]
+    (see REPORT.md). Subtracting A * b(h) from the per-token objective turns the
+    expected update at every prefix into the covariance Cov_q(A, s_y | h).
+
+    Only the sampler's top-k (ids, logprobs) are known. The remaining sampler
+    mass q_T = 1 - sum_K q is treated as one merged token, the trainer's tail
+    T = V minus K with log p(T) = log(1 - sum_K p): this assumes q restricted to the
+    tail is proportional to p there, and keeps the baseline exact on-policy
+    (q = p gives grad b = grad (sum_K p + p_T) = grad 1 = 0).
+    """
+    logp_k = take_vocab(logp_vocab, topk_ids)                         # [B, C, K]
+    logq_k = topk_logq.astype(jnp.float32)
+    pos = positive[..., None]
+    p_k = jnp.exp(logp_k)
+    tail_p = 1.0 - p_k.sum(-1)
+    tail_q = jnp.clip(1.0 - jnp.exp(logq_k).sum(-1), 0.0, 1.0)
+    log_tail_p = jnp.log(jnp.maximum(tail_p, TAIL_FLOOR))
+    log_tail_q = jnp.log(jnp.maximum(tail_q, 1e-30))
+    tv_k = sg(jnp.abs(jnp.exp(logq_k) - p_k))
+    tv_t = sg(jnp.abs(tail_q - tail_p))
+    # sampler mass of each outcome, reweighted by the same detached w as the sampled token
+    m_k = sg(jnp.exp(log_mass(sg(logp_k), logq_k, pos, c, tv_k)))
+    m_t = sg(jnp.where(tail_q > 0, jnp.exp(log_mass(sg(log_tail_p), log_tail_q, positive, c, tv_t)), 0.0))
+    return (m_k * logp_k).sum(-1) + m_t * log_tail_p
+
+
