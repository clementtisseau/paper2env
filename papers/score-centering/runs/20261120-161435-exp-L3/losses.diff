+def sampler_drift(logp_vocab, topk_ids, topk_logprobs):
+    """Per-position baseline b(h) = sum_v (q(v|h) - p(v|h)) log p(v|h), over the
+    sampler's top-k tokens S. Its gradient is sum_{v in S} (q - p)(v|h) s_v,
+    the top-k part of the drift s_bar(h) = sum_v q(v|h) s_v (see REPORT.md).
+    All coefficients are stop-gradient: only the log p(v|h) factors carry
+    gradient. Zero when q = p on S, so the on-policy gradient is unchanged.
+    Returns zeros when the batch has no sampler top-k. Used only without an
+    IS correction (c is None): under a weight w(y) the baseline would need a
+    weight-consistent control variate, and the plain one biases the TIS update."""
+    if topk_ids is None:
+        return jnp.zeros(logp_vocab.shape[:2], logp_vocab.dtype)
+    logp_top = take_vocab(logp_vocab, topk_ids)  # [B, C, K], carries the gradient
+    coef = sg(jnp.exp(topk_logprobs.astype(logp_vocab.dtype)) - jnp.exp(sg(logp_top)))
+    return (coef * logp_top).sum(-1)
+
